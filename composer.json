{
    "name": "jovian/fb",
    "description": "Typed projection of ext-fb and the native framebuffer driver for Venusian Surface",
    "type": "library",
    "version": "0.8.0",
    "keywords": ["venusian", "surface", "framebuffer", "fb", "bindings"],
    "license": "MIT",
    "authors": [{"name": "Angel Gonzalez", "email": "angel@projectsaturnstudios.com"}],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "ext-fb": "^0.8.0",
        "surface/contracts": "^0.8.0",
        "venusian-voyager/nuts-and-bolts": "^0.8.0"
    },
    "require-dev": {
        "pestphp/pest": "^4",
        "venusian/surface": "^0.8.0"
    },
    "autoload": {"psr-4": {"Jovian\\Bindings\\Fb\\": "src/"}},
    "autoload-dev": {"psr-4": {"Jovian\\Bindings\\Fb\\Tests\\": "tests/"}},
    "repositories": [
        {"type": "path", "url": "../../venusian/surface"},
        {"type": "path", "url": "../../venusian/surface/src/Surface/Contracts", "options": {"symlink": true, "versions": {"surface/contracts": "0.8.0"}}},
        {"type": "path", "url": "../../venusian/framework/src/Voyager/Contracts", "options": {"symlink": true, "versions": {"venusian-voyager/contracts": "0.8.9"}}},
        {"type": "path", "url": "../../venusian/framework/src/Voyager/NutsAndBolts", "options": {"symlink": true, "versions": {"venusian-voyager/nuts-and-bolts": "0.8.9"}}},
        {"type": "path", "url": "../../venusian/framework/src/Voyager/IOPools", "options": {"symlink": true, "versions": {"venusian-voyager/io-pools": "0.8.9"}}},
        {"type": "path", "url": "../../venusian/framework/src/Voyager/MagicAliases", "options": {"symlink": true, "versions": {"venusian-voyager/magic-aliases": "0.8.9"}}},
        {"type": "path", "url": "../../venusian/framework/src/Voyager/Collections", "options": {"symlink": true, "versions": {"venusian-voyager/collections": "0.8.9"}}},
        {"type": "path", "url": "../../venusian/framework/src/Voyager/Conditionable", "options": {"symlink": true, "versions": {"venusian-voyager/conditionable": "0.8.9"}}},
        {"type": "path", "url": "../../venusian/framework/src/Voyager/Macroable", "options": {"symlink": true, "versions": {"venusian-voyager/macroable": "0.8.9"}}},
        {"type": "path", "url": "../../venusian/framework/src/Voyager/Reflection", "options": {"symlink": true, "versions": {"venusian-voyager/reflection": "0.8.9"}}}
    ],
    "config": {"sort-packages": true, "allow-plugins": {"pestphp/pest-plugin": true}},
    "extra": {
        "branch-alias": {"dev-main": "0.8.x-dev"},
        "venusian": {"providers": ["Jovian\\Bindings\\Fb\\Providers\\FbServiceProvider"], "aliases": {}}
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
